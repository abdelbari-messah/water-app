{
  "expo": {
    "name": "WaterWise",
    "slug": "waterwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/adaptive-icon.png",
    "scheme": "waterapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdelbari.waterwise",
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.abdelbari.waterwise"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png",
      "pwa": {
        "favicon": "./assets/icons/favicon.png",
        "name": "WaterWise",
        "shortName": "WaterWise",
        "lang": "en",
        "scope": "/",
        "themeColor": "#4A90E2",
        "description": "Track your daily water intake with ease",
        "backgroundColor": "#F5F7FA",
        "display": "standalone",
        "startUrl": "/",
        "orientation": "portrait"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/splash-icon-light.png",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c890b9ef-1195-440b-83b3-c0e833382066"
      }
    },
    "owner": "abdelbari"
  }
}
